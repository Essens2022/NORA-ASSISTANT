# Edge Function secrets – set with `supabase secrets set --env-file supabase/functions/.env`
# Never commit the real file. SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are provided by Supabase.

# AI (conversation → structured plan). Providers: groq | openai
AI_PROVIDER=groq
AI_MODEL=openai/gpt-oss-120b
AI_REASONING=low

# Speech-to-text. Providers: groq | openai
STT_PROVIDER=groq
STT_MODEL=whisper-large-v3

GROQ_API_KEY=
# OPENAI_API_KEY=

# Web Push (generate once: `npm run vapid`)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@nora.app

# Shared secret between pg_cron and the dispatch function (also stored in Vault as nora_cron_secret)
CRON_SECRET=

# Optional: restrict CORS to the web app origin
# APP_ORIGIN=https://app.nora.example
