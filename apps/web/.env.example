# Public values only (they ship to the browser). Never put service keys here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Optional: defaults to $VITE_SUPABASE_URL/functions/v1/api
VITE_API_URL=
# Optional feature flags (comma separated): google_login,apple_login
VITE_FEATURES=
