# Android (Capacitor): apps/web/android is a real generated native project and
# IS committed (Capacitor's own convention, unlike bubblewrap) - it has its own
# .gitignore for build output/local.properties/copied web assets. Only the
# signing keystore secret needs an extra rule here.
apps/web/android/android.keystore

# Local source images for icon/splash generation (npx @capacitor/assets) -
# kept out of git since they're just intermediates for the committed,
# already-generated android/app/src/main/res/** outputs.
apps/web/assets
